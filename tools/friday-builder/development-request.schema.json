{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhw77655-hue/Friday/blob/main/tools/friday-builder/development-request.schema.json",
  "title": "Friday Repository Development Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "source_revision",
    "intended_outcome",
    "evidence",
    "acceptance_criteria",
    "risks",
    "rollback_expectation",
    "unresolved_questions",
    "privacy_review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "source_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "intended_outcome": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 600 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 600 }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "rollback_expectation": { "type": "string", "minLength": 1, "maxLength": 800 },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": { "const": "approved" },
        "reviewed_by": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reviewed_at": { "type": "string", "format": "date-time", "maxLength": 40 }
      }
    }
  }
}
